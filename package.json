{
  "name": "nodejs_express_microservices",
  "module": "index.ts",
  "devDependencies": {
    "@prisma/cli-engine": "0.6.3",
    "@types/bun": "latest",
    "@types/express-http-proxy": "^1.6.7",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "prisma": "^8.0.0-rc.21",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "private": true,
  "scripts": {
    "products": "bun --watch app/products/index.ts",
    "api-gateway": "bun --watch app/api-gateway/index.ts",
    "orders": "bun --watch app/orders/index.ts",
    "start:dev": "concurrently \"bun run api-gateway\" \"bun run orders\"",
    "test:unit": "bun --watch --coverage test test/unit/",
    "contract:emit": "prisma contract emit"
  },
  "type": "module",
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.16",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2"
  }
}
