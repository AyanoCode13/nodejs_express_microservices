{
  "name": "nodejs_express_microservices",
  "module": "index.ts",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express-http-proxy": "^1.6.7",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.5",
    "supertest": "^7.3.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "private": true,
  "scripts": {
    "products": "bun --watch app/products/index.ts",
    "api-gateway": "bun --watch app/api-gateway/index.ts",
    "orders": "bun --watch app/orders/index.ts",
    "start:dev": "concurrently \"bun run api-gateway\" \"bun run orders\"",
    "test:unit": "bun --watch --coverage test test/unit/"
  },
  "type": "module",
  "dependencies": {
    "express": "^5.2.1",
    "express-http-proxy": "^2.1.2"
  }
}
